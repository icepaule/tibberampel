  {
    "id": "ampel_logic",
    "type": "function",
    "z": "tab_tibber_ampel",
    "name": "Ampel-Logik",
    "func": "// Tibber Preis-Status zu LED-Steuerung\n// Status: guenstig / normal / teuer\nvar status = msg.payload;\nvar rot = \"OFF\";\nvar gelb = \"OFF\";\nvar gruen = \"OFF\";\nvar label = \"?\";\n\nswitch(status) {\n    case \"günstig\":\n        gruen = \"ON\";\n        label = \"GRUEN (guenstig)\";\n        break;\n    case \"normal\":\n        gelb = \"ON\";\n        label = \"GELB (normal)\";\n        break;\n    case \"teuer\":\n        rot = \"ON\";\n        label = \"ROT (teuer)\";\n        break;\n    default:\n        // Unbekannter Status -> Gelb als Fallback\n        gelb = \"ON\";\n        label = \"GELB (unbekannt: \" + status + \")\";\n}\n\nnode.status({fill: gruen === \"ON\" ? \"green\" : rot === \"ON\" ? \"red\" : \"yellow\", shape: \"dot\", text: label});\n\nreturn [\n    {payload: rot},\n    {payload: gelb},\n    {payload: gruen}\n];",
    "outputs": 3,
    "timeout": "",
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 410,
    "y": 160,
    "wires": [
      ["ampel_mqtt_rot", "ampel_debug"],
      ["ampel_mqtt_gelb", "ampel_debug"],
      ["ampel_mqtt_gruen", "ampel_debug"]
    ],
    "outputLabels": ["Rot", "Gelb", "Gruen"]
  },
